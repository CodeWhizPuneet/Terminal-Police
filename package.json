{
  "name": "terminal-police",
  "displayName": "Terminal Police",
  "description": "Plays a custom sound alert when errors are detected in the VS Code integrated terminal.",
  "version": "1.0.0",
  "icon": "image/icon.png",
  "publisher": "codewhizpuneet",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeWhizPuneet/Terminal-Police"
  },
  "homepage": "https://github.com/CodeWhizPuneet/Terminal-Police#readme",
  "bugs": {
    "url": "https://github.com/CodeWhizPuneet/Terminal-Police/issues"
  },
  "keywords": [
    "terminal",
    "error",
    "sound",
    "alert",
    "notification",
    "command failure",
    "terminal errors",
    "audio alert",
    "Kya chhera",
    "Kya chheda bosdi",
    "Faah",
    "terminal police",
    "developer tools",
    "productivity",
    "build failure",
    "debugging"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "enabledApiProposals": [
    "terminalDataWriteEvent"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Terminal Police",
      "properties": {
        "terminalErrorSound.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the terminal error sound alert."
        },
        "terminalErrorSound.soundFile": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a custom sound file (mp3, wav). Leave empty to use the bundled default sound."
        },
        "terminalErrorSound.debounceDuration": {
          "type": "number",
          "default": 3000,
          "description": "Minimum time (in milliseconds) between consecutive sound alerts to prevent spamming."
        },
        "terminalErrorSound.detectLiveOutput": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time terminal output monitoring for venv and streaming errors (Python tracebacks, etc.). Works alongside exit code detection."
        },
        "terminalErrorSound.errorPatterns": {
          "type": "array",
          "default": [
            "Error",
            "error",
            "Exception",
            "exception",
            "Traceback",
            "traceback",
            "Failed",
            "failed",
            "FAILED",
            "ModuleNotFoundError",
            "ImportError",
            "SyntaxError",
            "ValueError",
            "TypeError",
            "AttributeError",
            "FileNotFoundError",
            "KeyError",
            "IndexError",
            "ZeroDivisionError",
            "RuntimeError",
            "OSError",
            "IOError"
          ],
          "description": "Array of patterns to detect error messages in terminal output. Add or customize patterns for error detection."
        },
        "terminalErrorSound.excludePatterns": {
          "type": "array",
          "default": [
            "no error",
            "error handling",
            "error message",
            "error code",
            "error recovery"
          ],
          "description": "Patterns to exclude from error detection (prevents false positives). Case-insensitive."
        }
      }
    },
    "commands": [
      {
        "command": "terminalErrorSound.toggle",
        "title": "Terminal Police: Toggle Enable/Disable"
      },
      {
        "command": "terminalErrorSound.testSound",
        "title": "Terminal Police: Test Sound"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.93.0",
    "typescript": "^5.3.0"
  }
}
